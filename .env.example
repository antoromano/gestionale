# .env.example
# Configurazione Parametri Gestionale (Tutte le credenziali sono configurabili anche da Impostazioni UI)

# Supabase PostgreSQL, Auth & Storage (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API (Configurabile anche via UI o su Supabase Edge Functions)
GEMINI_API_KEY=AIzaSy...

# Google Calendar 2-Way Sync (Configurato lato Edge Function)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REFRESH_TOKEN=1//04your-refresh-token

# Notion To-do Connector (Configurato lato Edge Function)
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your_notion_database_id
